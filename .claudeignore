# Claude 컨텍스트 크기·노이즈 조절: package-lock.json·대용량 바이너리(svg 등) 제외는 의도적.
# (검증·재현은 저장소·CI의 package-lock.json 및 에셋을 기준으로 한다.)

# Dependencies
node_modules/
.pnp/
.pnp.js

# Build output
.next/
out/
dist/
build/
.turbo/

# Cache
.cache/
.eslintcache
tsconfig.tsbuildinfo

# Generated
*.lock
package-lock.json

# IDE
.idea/
.vscode/
*.swp
*.swo

# OS
.DS_Store
Thumbs.db

# Test artifacts
coverage/
playwright-report/
test-results/
.playwright-mcp/

# Harness temp
_workspace/
.omc/
.gstack/

# Env files (sensitive)
.env
.env.*
!.env.example

# Logs
*.log
npm-debug.log*

# Images (large binaries)
*.png
*.jpg
*.jpeg
*.gif
*.webp
*.ico
*.svg
!public/favicon.ico

