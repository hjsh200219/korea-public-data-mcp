{
  "name": "public-data-mcp",
  "version": "1.0.0",
  "description": "대한민국 공공데이터 MCP 서버 (법제처 국가법령정보센터 API)",
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc",
    "start": "node --use-system-ca dist/remote.js",
    "start:stdio": "node --use-system-ca dist/index.js",
    "dev": "tsx --node-options='--use-system-ca' src/index.ts",
    "dev:remote": "tsx --node-options='--use-system-ca' src/remote.ts",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest",
    "lint": "eslint src/",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.scripts.json",
    "verify-docs": "tsx scripts/verify-docs.ts",
    "dead-code": "knip --no-config-hints",
    "verify-harness-meta": "tsx scripts/verify-harness-meta.ts",
    "gc": "npm run typecheck && npm run lint && npm run verify-docs && npm run dead-code && npm run verify-harness-meta && npm run test:coverage && npm run build",
    "register": "node scripts/register-claude-desktop.mjs",
    "register:local": "node scripts/register-claude-desktop.mjs --local",
    "unregister": "node scripts/register-claude-desktop.mjs --remove",
    "inspect": "npx @modelcontextprotocol/inspector node --use-system-ca dist/index.js",
    "prepare": "husky"
  },
  "keywords": [
    "mcp",
    "public-data",
    "korea",
    "law",
    "court"
  ],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.27.1",
    "cors": "^2.8.6",
    "express": "^5.2.1",
    "fast-xml-parser": "^5.4.1",
    "jszip": "^3.10.1",
    "youtube-transcript": "^1.3.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jszip": "^3.4.0",
    "@types/node": "^25.3.2",
    "@types/supertest": "^7.2.0",
    "@vitest/coverage-v8": "^4.1.3",
    "eslint": "^10.2.0",
    "husky": "^9.1.7",
    "knip": "^5.88.1",
    "lint-staged": "^16.4.0",
    "supertest": "^7.2.2",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.58.1",
    "vitest": "^4.1.2"
  },
  "lint-staged": {
    "src/**/*.ts": [
      "eslint --fix",
      "vitest related --run"
    ]
  }
}
